# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local HTTPS: the private CA, keys and per-machine certificates are generated by
# setup_local_https.ps1 and must never be committed (a public CA cert without its key
# would also confuse the setup script)
certs/

# Runtime data
data/*.sqlite3
data/*.sqlite3-*
data/bms_mos_encoding.json
backups/
logs/
*.log

# Hardware captures
captures/*.pcap

# Local user configuration
user_settings.json

# Third-party product photos, re-downloaded by cache_product_images.py (manifest stays tracked)
static/products/*
!static/products/sources.json

# OS / Drive noise
desktop.ini
Thumbs.db
.DS_Store
